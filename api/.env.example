# Copy to .env and fill in. Nothing here is required to run locally,
# the app just does less without a weather key.

# OpenWeatherMap, free tier. Without it weather mode falls back to
# shortest distance and says so.
OPENWEATHER_API_KEY=

# where the engine listens. loopback only, never expose this.
ENGINE_BIND_HOST=127.0.0.1
ENGINE_PORT=8081

# how long a weather reading is reused for
WEATHER_TTL_S=600

# per address limit on the public api
RATE_LIMIT=60/minute

# comma separated list, or a star while developing
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO
