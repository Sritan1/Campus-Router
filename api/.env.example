# Copy to .env and fill in. Nothing here is required to run locally,
# the app just does less without a weather key.

# OpenWeather, free tier. Without it weather mode falls back to
# shortest distance and says so.
OPENWEATHER_API_KEY=

# where the engine listens. loopback only, never expose this.
ENGINE_BIND_HOST=127.0.0.1
ENGINE_PORT=8081

# how long a weather reading is reused for
WEATHER_TTL_S=600

# how long to sit still after the weather service fails, so an outage
# costs one slow call a minute instead of one for every visitor
WEATHER_RETRY_AFTER_S=60

# per address limit on the public api
RATE_LIMIT=60/minute

# only behind a trusted proxy like railway, and off locally. anyone can send x
# forwarded for, so trusting it without one is a free way past the rate limit
TRUST_PROXY_HEADERS=false

# comma separated list, or a star while developing
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO
