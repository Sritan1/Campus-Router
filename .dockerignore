# an allowlist. docker uploads the whole folder before reading the Dockerfile,
# and the image only needs the engine and the gateway, so everything is out
# unless it is named here. anything new in the repo stays out by default

*
!engine
!api

# patterns match the whole path from the context root, unlike gitignore, so
# anything that can sit in a subfolder needs a leading star star

# build output, rebuilt inside the image
engine/build/
engine/bin/
**/*.o
**/*.obj
**/*.exe
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/

# tests run in ci, never in the image
api/tests/

# secrets never belong in an image layer, and a bare rule for the env file would
# miss the real one inside the api folder
**/.env
**/.env.*
