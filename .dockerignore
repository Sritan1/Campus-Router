# docker uploads the whole folder before reading the Dockerfile, so skip what
# nothing copies. node modules and the venv alone are hundreds of megabytes

.git/
.github/

# patterns match the whole path from the context root, unlike gitignore, so
# anything that can sit in a subfolder needs a leading star star

# dependencies and build output, all rebuilt inside the image
**/node_modules/
web/.next/
web/.next-verify/
web/out/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
engine/build/
engine/bin/
**/*.o
**/*.obj
**/*.exe

# secrets never belong in an image layer, and a bare rule for the env file would
# miss the real one inside the api folder
**/.env
**/.env.*
!**/.env.example




docs/
*.pdf


web/scripts/shots/

# the raw overpass dump, since the built graph is what ships
pipeline/.cache/
pipeline/raw/

.DS_Store
Thumbs.db
desktop.ini
