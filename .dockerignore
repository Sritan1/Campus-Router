# Docker sends the whole folder to the daemon before it reads the
# Dockerfile, so anything left in here is uploaded even though nothing
# copies it. node_modules and the venv alone are hundreds of megabytes.

.git/
.github/

# patterns here match the whole path from the context root, not just a
# file name the way gitignore does, so anything that can turn up in a
# subfolder needs the leading star star or it only matches at the top.

# dependencies and build output, all rebuilt inside the image
**/node_modules/
web/.next/
web/.next-verify/
web/out/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
engine/build/
engine/bin/
**/*.o
**/*.obj
**/*.exe

# secrets never belong in an image layer. api/.env is a real file here
# and a bare .env rule would sail straight past it.
**/.env
**/.env.*
!**/.env.example




docs/
*.pdf


web/scripts/shots/

# the raw overpass dump. the built graph in api/data is what ships.
pipeline/.cache/
pipeline/raw/

.DS_Store
Thumbs.db
desktop.ini
